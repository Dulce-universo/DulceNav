# ============================================================
# DulceNav — .gitignore
# ============================================================

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore

# Windows
windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# iOS / macOS (aunque no estamos compilando para estas plataformas aún)
**/ios/Flutter/.last_build_id
**/macos/Flutter/GeneratedPluginRegistrant.swift

# VS Code
.vscode/
*.code-workspace

# IntelliJ / Android Studio
.idea/
*.iml

# Logs y caché
*.log
*.cache
*.hprof

# Archivos de entorno (¡NUNCA subir claves!)
.env
.env.*
secrets.properties

# Assets generados
/assets/generated/

# WebView local cache y sesion
.webview_data/

# Distribución local de binarios
dist/
