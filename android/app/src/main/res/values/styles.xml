<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema que se muestra al iniciar la app (Launch screen) -->
    <style name="LaunchTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema normal de la app una vez inicializada -->
    <style name="NormalTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
